---
// The two rates side by side: for each 2-byte weight that arrives from memory, the operations the
// H200 has time for, against the two one token does with it.
import { count, worked } from "../lib/format";
import { BALANCE_POINT } from "../lib/model";
import { W } from "../lib/toy";

const used = 2;
const possible = Math.round(BALANCE_POINT * 2);
const COLS = 46;
const PITCH = 8;
const rows = Math.ceil(possible / COLS);
const dots = Array.from({ length: possible }, (_, i) => ({
	x: (i % COLS) * PITCH + 4,
	y: Math.floor(i / COLS) * PITCH + 4,
}));
---

<div class="budget">
	<p class="arrives">
		<span class="obj-weight" aria-hidden="true">{worked(W[0][0])}</span>
		<span>for each 16-bit weight that arrives from memory</span>
	</p>
	<p class="top">the chip has time for {count(possible)} operations</p>
	<svg
		viewBox={`0 0 ${COLS * PITCH} ${rows * PITCH}`}
		role="img"
		aria-label={`${count(possible)} dots, ${used} of them filled: for each 16-bit weight that arrives, the chip has time for ${count(possible)} operations and one token uses ${used}.`}
	>
		{dots.map((d, i) => <circle class:list={{ used: i < used }} cx={d.x} cy={d.y} r={i < used ? 3 : 1.6} />)}
	</svg>
	<p class="bottom"><span aria-hidden="true">● </span>{used} used by one token</p>
</div>

<style>
	.budget {
		max-width: 30rem;
		margin: 0 auto;
		font: 0.8125rem/1.4 var(--mono);
		color: var(--ink-2);
	}
	p {
		margin: 0;
	}
	.arrives {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
		--obj: 1.75rem;
	}
	.arrives .obj-weight {
		padding: 0 0.375rem;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		margin: 0.625rem 0;
	}
	circle {
		fill: var(--rule);
	}
	circle.used {
		fill: var(--math);
	}
	.bottom {
		color: var(--math-ink);
	}
</style>
