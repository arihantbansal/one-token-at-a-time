---
// The first three passes of a reply as a filmstrip: what goes into each pass, what is kept from
// before, and the token that comes out. Uses the same prompt and reply as TokenLoop.
import { PROMPT, REPLY } from "../lib/tokenLoop";

const prompt = PROMPT.map((t) => t.trim());
const reply = REPLY.slice(0, 3).map((t) => t.trim());

const frames = reply.map((out, i) => ({
	label: i === 0 ? "pass 1 takes in the whole prompt" : `pass ${i + 1} takes in only the newest token`,
	kept: i === 0 ? [] : [...prompt, ...reply.slice(0, i - 1)],
	fresh: i === 0 ? prompt : [reply[i - 1]],
	out,
}));
---

<div class="loop">
	<p class="key">
		<span><i class="obj-work" aria-hidden="true"></i> new in this pass</span>
		<span><i class="obj-cache" aria-hidden="true"></i> kept from earlier passes</span>
	</p>
	<ol>
		{
			frames.map((f) => (
				<li>
					<p class="label">{f.label}</p>
					<div
						class="row"
						role="img"
						aria-label={`${f.kept.length ? `kept from earlier passes: ${f.kept.join(" ")}; ` : ""}new in this pass: ${f.fresh.join(" ")}; writes ${f.out}`}
					>
						<div class="in">
							{f.kept.map((t) => (
								<span class="obj-cache">{t}</span>
							))}
							{f.fresh.map((t) => (
								<span class="obj-work">{t}</span>
							))}
						</div>
						<span class="arrow" aria-hidden="true">
							→
						</span>
						<span class="out">{f.out}</span>
					</div>
				</li>
			))
		}
	</ol>
</div>

<style>
	.loop {
		max-width: 38rem;
		margin: 0 auto;
		font: 0.8125rem/1.4 var(--mono);
		color: var(--ink-2);
		--obj: 1.625rem;
	}
	p {
		margin: 0;
	}
	.key {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 1.25rem;
		margin-bottom: 1.25rem;
	}
	.key span {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}
	.key i {
		--obj: 0.875rem;
	}
	ol {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.label {
		margin-bottom: 0.375rem;
		color: var(--ink);
	}
	.row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.in {
		display: flex;
		flex-wrap: wrap;
		gap: 3px;
	}
	.in span,
	.out {
		padding: 0 0.375rem;
	}
	.arrow {
		flex: none;
		color: var(--ink);
	}
	.out {
		flex: none;
		display: inline-grid;
		place-items: center;
		height: var(--obj);
		border: 2px solid var(--ink);
		color: var(--ink);
	}
</style>
