---
// One sliding-window layer for one person as a chain of kernels on one time axis: first each at
// its ideal time, then with the same fixed cost added to every kernel. The fixed cost is an
// assumption (`FIXED_US`); the ideal times come from the cost model and the contest's floors.
import { count, us } from "../lib/format";
import { FIXED_US, layerChain } from "../lib/kernels";

const chain = layerChain("sliding");
const tenths = (n: number) => Math.round(n * 10) / 10;
const part = (kind: string) => tenths(chain.filter((k) => k.kind === kind).reduce((a, k) => a + k.us, 0));
const n = (kind: string) => chain.filter((k) => k.kind === kind).length;
const weights = part("weights");
const cache = part("cache");
const small = part("small");
const ideal = tenths(weights + cache + small);
const fixed = tenths(chain.length * FIXED_US);
const withFixed = tenths(ideal + fixed);
const scale = withFixed;
const pct = (x: number) => `${(x / scale) * 100}%`;
const ticks = Array.from({ length: Math.floor(scale / 10) + 1 }, (_, i) => i * 10);

const FRAMES = [
	{ title: "each kernel at its ideal time", fixedUs: 0, total: ideal },
	{ title: `with ${us(FIXED_US)} of fixed cost per kernel`, fixedUs: FIXED_US, total: withFixed },
];
---

<div class="timeline">
	<p class="key" aria-hidden="true">
		<span><i class="work"></i>moving data</span>
		<span><i class="fixed"></i>fixed cost: start, wait, finish</span>
	</p>
	{
		FRAMES.map((f) => (
			<section>
				<h3>{f.title}</h3>
				<div
					class="bar"
					role="img"
					aria-label={`${count(chain.length)} kernels in a row, ${us(f.total)} in all${f.fixedUs ? `, of which ${us(fixed)} is fixed cost` : ""}`}
				>
					{chain.map((k) => (
						<>
							{f.fixedUs > 0 && <i class="fixed" style={`width: ${pct(f.fixedUs)}`} />}
							<i class="work" style={`width: ${pct(k.us)}`} />
						</>
					))}
				</div>
				<p class="total">
					{count(chain.length)} kernels: <b>{us(f.total)}</b>
				</p>
			</section>
		))
	}
	<div class="axis" aria-hidden="true">
		{
			ticks.map((t) => (
				<span style={`left: ${pct(t)}`}>{t}</span>
			))
		}
	</div>
	<p class="unit">time from the layer's start, in µs</p>
	<dl class="sums">
		<div><dt>{count(n("weights"))} kernels that read weights</dt><dd>{us(weights)}</dd></div>
		<div><dt>attention, reading the cache</dt><dd>{us(cache)}</dd></div>
		<div><dt>{count(n("small"))} small steps</dt><dd>{us(small)}</dd></div>
		<div class="line"><dt>ideal, in all</dt><dd>{us(ideal)}</dd></div>
		<div><dt>{count(chain.length)} fixed costs of {us(FIXED_US)}</dt><dd>{us(fixed)}</dd></div>
		<div class="line"><dt>with fixed costs</dt><dd>{us(withFixed)}</dd></div>
	</dl>
	<p class="note">fixed cost assumed for illustration; ideal times are lower bounds</p>
</div>

<style>
	.timeline {
		display: grid;
		gap: 1.25rem;
		max-width: 40rem;
		margin: 0 auto;
		font: 0.8125rem/1.4 var(--mono);
		color: var(--ink-2);
	}
	p {
		margin: 0;
	}
	.key {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
	}
	.key i {
		display: inline-block;
		width: 1.5rem;
		height: 0.75rem;
		margin-right: 0.5rem;
		vertical-align: -0.1rem;
	}
	h3 {
		margin: 0 0 0.375rem;
		font: inherit;
		color: var(--ink);
	}
	.bar {
		display: flex;
		height: 1.5rem;
		border-left: 1px solid var(--ink-2);
	}
	.bar i {
		flex: none;
		min-width: 1px;
	}
	.work {
		background: var(--bytes);
		box-shadow: inset -1px 0 0 var(--paper-2);
	}
	.fixed {
		background: repeating-linear-gradient(135deg, var(--ink-2) 0 1.5px, transparent 1.5px 5px);
		box-shadow: inset 0 0 0 0.5px var(--ink-2);
	}
	.total {
		margin-top: 0.375rem;
		text-align: right;
	}
	b {
		font-weight: inherit;
		color: var(--ink);
	}
	.axis {
		position: relative;
		height: 1.25rem;
		margin-top: -0.5rem;
		border-top: 1px solid var(--ink-2);
		font-size: 0.75rem;
	}
	.axis span {
		position: absolute;
		top: 0.2rem;
		transform: translateX(-50%);
	}
	.axis span:first-child {
		transform: none;
	}
	.axis .unit {
		right: 0;
		left: auto;
		transform: none;
	}
	.sums {
		display: grid;
		gap: 0.25rem;
		max-width: 26rem;
		margin: 0;
	}
	.sums div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	.sums .line {
		padding-top: 0.25rem;
		border-top: 1px solid var(--rule);
		color: var(--ink);
	}
	dd {
		margin: 0;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.note {
		font-size: 0.75rem;
	}
</style>
