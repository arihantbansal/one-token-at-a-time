---
// A row of labelled numbers. A figure updates one with `this.out(key, text)`.
type Item = { key: string; label: string; tone?: "bytes" | "math"; value?: string };
type Props = { items: Item[] };
const { items } = Astro.props;
---

<dl class="readout">
	{
		items.map((item) => (
			<div>
				<dt class:list={[item.tone]}>
					{item.tone && <span class="mark" aria-hidden="true">{item.tone === "bytes" ? "■ " : "● "}</span>}
					{item.label}
				</dt>
				<dd data-out={item.key}>{item.value ?? "–"}</dd>
			</div>
		))
	}
</dl>

<style>
	.readout {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
		gap: 0.75rem 1.5rem;
		margin: 1.5rem 0 1rem;
		font-family: var(--mono);
		font-size: 0.8125rem;
	}
	dt {
		color: var(--ink-2);
	}
	dt.bytes {
		color: var(--bytes-ink);
	}
	dt.math {
		color: var(--math-ink);
	}
	dd {
		margin: 0.2rem 0 0;
		font-variant-numeric: tabular-nums;
	}
</style>
