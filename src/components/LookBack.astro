---
// Invented shares for "bank", looking back over itself and the tokens before it.

const SHARES = [
	{ word: "we", share: 10 },
	{ word: "sat", share: 15 },
	{ word: "on", share: 13 },
	{ word: "the", share: 12 },
	{ word: "river", share: 30 },
	{ word: "bank", share: 20 },
];
const total = SHARES.reduce((sum, s) => sum + s.share, 0);
const pct = (n: number) => (n / total).toFixed(2);
---

<div class="look">
	<p class="head"><span class="obj-op" aria-hidden="true"></span> how much each token counts in the blend for "bank"</p>
	<ol class="rows">
		{
			SHARES.map((s, i) => (
				<li class:list={{ self: i === SHARES.length - 1 }}>
					<span class:list={["word", i === SHARES.length - 1 ? "obj-work" : "obj-cache"]}>{s.word}</span>
					<span class="track" aria-hidden="true">
						<i style={`--w: ${s.share / total}`} />
					</span>
					<span class="n">{pct(s.share)}</span>
				</li>
			))
		}
		<li class="later">
			<span class="word ghost">…</span>
			<span class="track empty">not written yet, so not looked at</span>
		</li>
	</ol>
</div>

<style>
	.look {
		max-width: 32rem;
		margin: 0 auto;
		font: 0.8125rem/1.4 var(--mono);
		color: var(--ink-2);
	}
	.head {
		margin: 0 0 0.875rem;
		color: var(--math-ink);
	}
	.head .obj-op {
		margin-right: 0.25rem;
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.375rem;
	}
	li {
		display: grid;
		grid-template-columns: 4rem 1fr 2.75rem;
		align-items: center;
		gap: 0.75rem;
	}
	.word {
		--obj: 1.75rem;
		width: 100%;
	}
	.track {
		height: 0.75rem;
		border-left: 1px solid var(--ink-2);
	}
	.track i {
		display: block;
		height: 100%;
		width: calc(var(--w) * 100%);
		background: var(--math);
	}
	.n {
		text-align: right;
		color: var(--math-ink);
		font-variant-numeric: tabular-nums;
	}
	.later {
		margin-top: 0.25rem;
	}
	.ghost {
		display: grid;
		place-items: center;
		height: 1.75rem;
		border: 1px dashed var(--rule);
	}
	.empty {
		grid-column: 2 / -1;
		height: auto;
		border-left: 1px dashed var(--rule);
		padding-left: 0.5rem;
		font-size: 0.75rem;
	}
</style>
