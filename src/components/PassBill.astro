---
// One pass's ideal time at each number of people, split by what it reads. Every panel shares one
// fixed scale. The parts are whole microseconds that add up to the total shown (serving.ts).
import { count, microseconds } from "../lib/format";
import { type BillLine, billLines } from "../lib/serving";

type Props = { people: number[] };
const bills = Astro.props.people.map(billLines);

const LABEL: Record<BillLine["key"], { text: (people: number) => string; obj: string }> = {
	weights: { text: () => "weights everyone shares", obj: "obj-weight" },
	experts: { text: () => "expert weights, inferred*", obj: "obj-weight" },
	cache: { text: (n) => (n === 1 ? "the cache" : "caches, one per person"), obj: "obj-cache" },
	working: { text: () => "working numbers", obj: "obj-work" },
};
const STEP = 1000;
const most = Math.max(...bills.flatMap((b) => b.lines.map((l) => l.us)));
const full = Math.ceil(most / STEP) * STEP;
const MARKS = Array.from({ length: full / STEP + 1 }, (_, i) => i * STEP);
const who = (n: number) => (n === 1 ? "1 person" : `${count(n)} people`);
---

<div class="bills" style={`--panels: ${bills.length}`}>
	{
		bills.map((b) => (
			<section class="bill">
				<h3>{who(b.people)}</h3>
				<dl>
					{b.lines.map((l) => (
						<div class="line">
							<dt>
								<span class:list={["mark", LABEL[l.key].obj]} aria-hidden="true" />
								{LABEL[l.key].text(b.people)}
							</dt>
							<dd>
								<span class="track" aria-hidden="true">
									{MARKS.slice(1, -1).map((t) => (
										<span class="grid" style={`--at: ${t / full}`} />
									))}
									<i style={`--w: ${l.us / full}`} />
								</span>
								<span class="t">{microseconds(l.us)}</span>
							</dd>
						</div>
					))}
				</dl>
				<p class="axis" aria-hidden="true">
					{MARKS.map((t) => (
						<span style={`--at: ${t / full}`}>{t === 0 ? "0" : count(t)}</span>
					))}
				</p>
				<p class="total">
					<span>
						<span class="bytes" aria-hidden="true">
							■{" "}
						</span>
						a pass, at least
					</span>
					<b>{microseconds(b.totalUs)}</b>
				</p>
				<p class="speed">
					<span>{b.people === 1 ? "tokens a second" : "tokens a second, each"}</span>
					<b>{count(b.each)}</b>
				</p>
				<p class="speed">
					<span>{b.people === 1 ? "" : "tokens a second, all"}</span>
					<b>{b.people === 1 ? "" : count(b.all)}</b>
				</p>
			</section>
		))
	}
	<p class="note">
		µs per pass on the busiest of the eight GPUs, at the judge's floor. *What the floor leaves after the other lines.
	</p>
</div>

<style>
	.bills {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
		gap: 2rem 1.75rem;
		max-width: calc(var(--panels) * 20rem);
		margin: 0 auto;
		font: 0.8125rem/1.4 var(--mono);
		color: var(--ink-2);
	}
	h3 {
		margin: 0 0 0.75rem;
		padding-bottom: 0.375rem;
		border-bottom: 1px solid var(--ink-2);
		font: inherit;
		color: var(--ink);
	}
	dl {
		display: grid;
		gap: 0.625rem;
		margin: 0;
	}
	dt {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.mark {
		--obj: 0.75rem;
		flex: none;
		width: 0.75rem;
		min-width: 0;
	}
	dd {
		display: grid;
		grid-template-columns: 1fr 4.5rem;
		align-items: center;
		gap: 0.5rem;
		margin: 0.2rem 0 0;
	}
	.track {
		position: relative;
		height: 0.875rem;
		border-left: 1px solid var(--ink-2);
	}
	.grid {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--at) * 100%);
		border-left: 1px dashed var(--rule);
	}
	.track i {
		position: relative;
		display: block;
		height: 100%;
		width: max(2px, calc(var(--w) * 100%));
		background: var(--bytes);
	}
	.t {
		text-align: right;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}
	/* The axis spans the track column only. */
	.axis {
		position: relative;
		height: 1rem;
		margin: 0.25rem 5rem 0 0;
		font-size: 0.6875rem;
	}
	.axis span {
		position: absolute;
		left: calc(var(--at) * 100%);
		transform: translateX(-50%);
		white-space: nowrap;
	}
	.axis span:first-child {
		transform: none;
	}
	p {
		margin: 0;
	}
	.total,
	.speed {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		min-height: 1.4em;
	}
	.total {
		margin-top: 1rem;
		padding-top: 0.5rem;
		border-top: 1px dashed var(--rule);
	}
	b {
		font-weight: inherit;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.note {
		grid-column: 1 / -1;
		font-size: 0.75rem;
		text-align: right;
	}
</style>
